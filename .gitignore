# SubStellar .gitignore

# Node & Frontend dependencies
node_modules/
dist/
dist-ssr/
*.local
.npm

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust & Tauri artifacts
src-tauri/target/
src-tauri/gen/
target/
*.pdb

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
Thumbs.db
.DS_Store

# Temporary build / download / media cache
.cache/
temp/
tmp/
docs/
CHANGELOG.md

# Kuromoji dictionary copied from node_modules on postinstall
public/dict/

